<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5D3DE"
    tools:context=".livedata.ui.fragment.experts.TopExpertsFragment">


    <LinearLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/expert_top_bg"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/headerSwitch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/shape_rect_expert"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">

                <TextView
                    android:id="@+id/matchExperts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_rectangle"
                    android:backgroundTint="@color/yellow_lgt"
                    android:gravity="center"
                    android:text="@string/experts_match"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tossExperts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_rectangle"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="@string/experts_toss"
                    android:textAllCaps="false"
                    android:textColor="@color/black" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/firstBelowLinear"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_below="@id/headerSwitch"
                android:layout_centerHorizontal="true">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/firstExpertImage"
                    android:layout_width="@dimen/_55sdp"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@mipmap/ic_launcher_round"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="@dimen/_1sdp" />


                <TextView
                    android:id="@+id/firstExpertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:ellipsize="end"
                    style="@style/font_bold"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    tools:text="User Name" />

                <LinearLayout
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/_10sdp"
                    android:background="@drawable/expert_build_one"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/star_build"
                        android:elevation="@dimen/_10sdp"
                        android:layout_margin="@dimen/_1sdp"
                        android:layout_gravity="center"/>


                    <TextView
                        android:id="@+id/firstExpertPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:ellipsize="end"
                        android:layout_marginTop="@dimen/_10sdp"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        tools:text="1200 Pts." />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:text="Accuracy"
                        android:textColor="@color/black"
                        android:textSize="11sp" />


                    <TextView
                        android:id="@+id/firstExpertAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/round_bg"
                        android:backgroundTint="#3B3838"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:paddingLeft="@dimen/_10sdp"
                        android:paddingRight="@dimen/_10sdp"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="11sp" />


                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/secondBelowLinear"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_25sdp"
                android:layout_below="@id/headerSwitch"
                android:layout_toLeftOf="@id/firstBelowLinear">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/secondExpertImage"
                    android:layout_width="@dimen/_55sdp"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@mipmap/ic_launcher_round"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="@dimen/_1sdp" />


                <TextView
                    android:id="@+id/secondExpertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:ellipsize="end"
                    style="@style/font_bold"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    tools:text="User Name" />

                <LinearLayout
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/_10sdp"
                    android:background="@drawable/expert_build_two"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/star_build"
                        android:elevation="@dimen/_10sdp"
                        android:layout_margin="@dimen/_1sdp"
                        android:layout_gravity="center"/>


                    <TextView
                        android:id="@+id/secondExpertPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:ellipsize="end"
                        android:layout_marginTop="@dimen/_10sdp"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        tools:text="1200 Pts." />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:text="Accuracy"
                        android:textColor="@color/black"
                        android:textSize="11sp" />


                    <TextView
                        android:id="@+id/secondExpertAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/round_bg"
                        android:backgroundTint="#3B3838"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:paddingLeft="@dimen/_10sdp"
                        android:paddingRight="@dimen/_10sdp"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="11sp" />


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/thirdBelowLinear"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_below="@id/headerSwitch"
                android:layout_toRightOf="@id/firstBelowLinear">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/thirdExpertImage"
                    android:layout_width="@dimen/_55sdp"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@mipmap/ic_launcher_round"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="@dimen/_1sdp" />


                <TextView
                    android:id="@+id/thirdExpertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:ellipsize="end"
                    style="@style/font_bold"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    tools:text="User Name" />

                <LinearLayout
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/_10sdp"
                    android:background="@drawable/expert_build_three"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/star_build"
                        android:elevation="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_gravity="center"/>


                    <TextView
                        android:id="@+id/thirdExpertPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:ellipsize="end"
                        android:layout_marginTop="@dimen/_10sdp"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        tools:text="1200 Pts." />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:text="Accuracy"
                        android:textColor="@color/black"
                        android:textSize="11sp" />


                    <TextView
                        android:id="@+id/thirdExpertAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/round_bg"
                        android:backgroundTint="#3B3838"
                        android:ellipsize="end"
                        style="@style/font_bold"
                        android:gravity="center"
                        android:paddingLeft="@dimen/_10sdp"
                        android:paddingRight="@dimen/_10sdp"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="11sp" />


                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/shape_round_bg_top"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:orientation="horizontal"
                android:padding="@dimen/_5sdp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_4sdp"
                    android:layout_weight="0.60"
                    style="@style/font_bold"
                    android:text="User Name"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_4sdp"
                    android:layout_weight="0.20"
                    style="@style/font_bold"
                    android:gravity="center"
                    android:text="Points"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_4sdp"
                    android:layout_weight="0.20"
                    style="@style/font_bold"
                    android:text="Accuracy"
                    android:textColor="@color/white"
                    android:textSize="13sp" />


            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerExperts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_experts_list" />


                <LinearLayout
                    android:id="@+id/linearlayout_if_live_not_show_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:src="@drawable/ic_undraw_season_calender" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tv_livescorepage_upcomingdateshow1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/font_regular"
                            android:text="Come back soon"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_livescorepage_upcomingdateshow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="7dp"
                            android:layout_toRightOf="@+id/tv_livescorepage_upcomingdateshow1"
                            style="@style/font_regular"
                            android:text=""
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </RelativeLayout>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>


    </LinearLayout>


    <include
        android:id="@+id/progress_layout"
        layout="@layout/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>