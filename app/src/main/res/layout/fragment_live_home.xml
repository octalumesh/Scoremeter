<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        tools:context=".ui.fragments.live.LiveFragment">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMatchesHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:listitem="@layout/item_home_list"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateDrawable="@drawable/custom_progress" />

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/linearlayout_if_live_not_show_image"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_70sdp"
                android:src="@drawable/ic_undraw_season_calender"
                />

            <RelativeLayout
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_livescorepage_upcomingdateshow1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_regular"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Come back soon"
                    />

                <TextView
                    android:visibility="gone"
                    android:id="@+id/tv_livescorepage_upcomingdateshow"
                    android:layout_toRightOf="@+id/tv_livescorepage_upcomingdateshow1"
                    android:layout_marginLeft="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    style="@style/font_regular"
                    android:text=""
                    />

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>
</layout>