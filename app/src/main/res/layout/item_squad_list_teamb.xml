<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data class="ItemSquadBindingTeamB">

    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_table"
        android:paddingVertical="0.5dp">


        <RelativeLayout
            android:id="@+id/parentSquad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5dp"
            android:background="@color/card_view_white"
            android:padding="@dimen/_5sdp">

            <RelativeLayout
                android:id="@+id/rerlative_teama_squa"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:layout_toLeftOf="@id/linearImage">


                <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/img_squad_player"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    app:civ_border_color="@color/txt_color"
                    app:civ_border_width="0.5dp"
                    tools:src="@drawable/viratone" />


            </RelativeLayout>


            <LinearLayout
                android:id="@+id/linearImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_inout"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/ic_baseline_rank_down"
                    android:visibility="gone" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvPlayerName"
                style="@style/font_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_toLeftOf="@+id/rerlative_teama_squa"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@color/txt_color"
                android:textSize="13sp"
                tools:text="Rohit" />

            <TextView
                android:id="@+id/tvPlayerRole"
                style="@style/font_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvPlayerName"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_toLeftOf="@+id/rerlative_teama_squa"
                android:text="Batsman"
                android:textColor="@color/txt_lgt"
                android:textSize="10sp" />

        </RelativeLayout>


    </RelativeLayout>
</layout>