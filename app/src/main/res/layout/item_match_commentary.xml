<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data
        class="ItemCommentaryBinding">

    </data>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="@dimen/_5sdp"
        android:layout_marginLeft="@dimen/_3sdp"
        android:layout_marginRight="@dimen/_3sdp"
        >

        <RelativeLayout
            android:id="@+id/relativeOverComplete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingVertical="@dimen/_4sdp"
            >
            <View
                android:visibility="gone"
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/colorAccent" />

            <TextView
                android:id="@+id/overTitleMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_toLeftOf="@id/linearScore"
                style="@style/font_regular"
                android:layout_below="@id/view"
                android:textColor="@color/colorAccent"
                android:layout_marginTop="@dimen/_5sdp"
                android:textSize="13sp"
                tools:text="End  Of Over 20" />

            <LinearLayout
                android:id="@+id/linearScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/gradiant_round"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:paddingLeft="@dimen/_5sdp"
                android:paddingRight="@dimen/_5sdp"
                android:paddingTop="@dimen/_3sdp"
                android:paddingBottom="@dimen/_3sdp">

                <TextView
                    android:id="@+id/overTitleTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_regular"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="Super Kings" />

                <TextView
                    android:id="@+id/overTitleScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_regular"
                    android:textSize="14sp"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:textColor="@color/yellow_lgt"
                    android:textStyle="bold"
                    tools:text="150/3" />


            </LinearLayout>


            <TextView
                android:id="@+id/overTitleRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/overTitleMain"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                style="@style/font_bold"
                android:textSize="14sp"
                android:textColor="@color/colorAccent"
                tools:text="19 Run" />

            <View
                android:id="@+id/xyz_bottomborder_commentry"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_below="@+id/overTitleRun"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:background="@color/gray" />

            <LinearLayout
                android:id="@+id/overScoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/xyz_bottomborder_commentry">

                <LinearLayout
                    android:id="@+id/overBatsmens"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.50"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/overPlayer1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="virat               25(13)"
                        android:layout_below="@id/overTitleMain"
                        android:textColor="@color/colorAccent"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:textSize="12sp"
                        style="@style/font_regular"/>

                    <TextView
                        android:id="@+id/overPlayer2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="rohit               45(23)"
                        android:layout_below="@id/overTitleMain"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:layout_marginLeft="@dimen/_5sdp"
                        style="@style/font_regular"/>

                </LinearLayout>

                <View
                    android:id="@+id/include"
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/white"
                    android:layout_toRightOf="@+id/relative_matchdetails1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.50"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/overBolwer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="mustafizur rheman 4-0-28-3"
                        android:layout_below="@id/overTitleMain"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_regular"/>

                </LinearLayout>

            </LinearLayout>

            <!--        <View-->
            <!--            android:layout_width="match_parent"-->
            <!--            android:layout_height="@dimen/_1sdp"-->
            <!--            android:layout_below="@id/overScoreCard"-->
            <!--            android:background="@color/white_lgt" />-->


        </RelativeLayout>

    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:id="@+id/overDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_3sdp"
        android:elevation="@dimen/_5sdp"
        android:layout_marginLeft="@dimen/_1sdp"
        android:layout_marginRight="@dimen/_1sdp"
        android:layout_marginBottom="@dimen/_1sdp"
        android:layout_marginHorizontal="10dp"
        android:paddingVertical="4dp"
        >



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_5sdp">

            <TextView
                android:id="@+id/commentaryOver"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                tools:text="19.3"
                android:gravity="center"
                style="@style/font_bold"
                android:textColor="@color/black"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:id="@+id/overRuns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3 Runs"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textSize="12sp"
                android:layout_marginLeft="5dp"
                style="@style/font_bold"/>


            <TextView
                android:id="@+id/overTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text=", Bumrah to rohit"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_5sdp"
                style="@style/font_bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="3dp">

            <TextView
                android:id="@+id/tv_over_run_commentry"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="10dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                style="@style/font_bold"
                android:textSize="10sp"
                android:text="-"
                android:textColor="@color/black"
                android:background="@drawable/cricle_shape_round"/>

        <TextView
            android:id="@+id/overDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="flick to the leg side for 3 runs"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="15dp"
            style="@style/font_regular"/>

        </LinearLayout>

        <View
            android:id="@+id/viewCommen"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:background="@color/gray" />

    </LinearLayout>

</LinearLayout>
</layout>