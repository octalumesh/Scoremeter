<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data
        class="ItemRecentTransactionBinding">

    </data>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_8sdp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/linearEnd">


            <TextView
                android:id="@+id/winType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Winning refer and earn"
                android:textColor="@color/black"
                android:textSize="18sp"
                style="@style/font_bold"
                />

            <TextView
                android:id="@+id/transactionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction ID: SPORT115012365870"
                android:textColor="@color/gray_dark"
                android:textSize="15sp"
                style="@style/font_bold"
                />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u20B954545"
                android:textColor="@color/black"
                android:textSize="16sp"
                style="@style/font_bold"
                />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Success"
                android:textColor="@color/black"
                android:textSize="15sp"
                style="@style/font_regular"
                />

        </LinearLayout>

    </RelativeLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray"/>

</LinearLayout>
</layout>