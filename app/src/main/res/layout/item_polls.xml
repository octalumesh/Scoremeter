<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:bind="http://schemas.android.com/tools">
    <data
        class="ItemPollsBinding">
        <import type="android.view.View"/>
        <variable
            name="model"
            type="com.cricbuzzplus.liveline.livedata.response.PollsResponse" />

        <variable
            name="myvote"
            type="Boolean" />


    </data>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/darkstatusbar1"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:elevation="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainLinear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:orientation="horizontal">

                <!--android:text="@{model.team_a_img}"-->
                <TextView
                    android:id="@+id/series"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_weight="0.60"
                    style="@style/font_bold"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:text="@{``+model.series}"
                    tools:text="Nambia tour of Zimbabwe, 2022"
                    android:textColor="@color/black" />


                <TextView
                    android:id="@+id/dateTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.40"
                    android:layout_gravity="end"
                    android:gravity="end"
                    android:text="@{``+model.match_date +`, `+ model.match_time}"
                    style="@style/font_bold"
                    tools:text="19 May , 04:30PM"
                    android:textColor="@color/black" />


            </LinearLayout>

            <TextView
                android:id="@+id/venue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                style="@style/font_bold"
                android:text="@{``+model.venue}"
                tools:text="Mahinda Rajapaksa International Stadium"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/whoWin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="Who will win?"
                android:visibility="@{myvote == true ? View.GONE : View.VISIBLE}"
                style="@style/font_bold"
                android:textColor="@color/colorAccent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/winPrediction"
                android:visibility="@{myvote == true ? View.VISIBLE : View.GONE}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_8sdp"
                android:paddingLeft="@dimen/_40sdp"
                android:paddingRight="@dimen/_40sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:text="Winning Predictions"
                android:background="@drawable/shape_rectangle"
                android:backgroundTint="@color/colorAccent"
                style="@style/font_bold"
                android:textColor="@color/white"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".40"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/teamAImage"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        tools:src="@mipmap/ic_launcher_round"
                        bind:loadimage="@{model.team_a_img}"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/teamAName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Roy"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:text="@{model.team_a_name}"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />
                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight=".10"
                    android:src="@drawable/swap" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".40"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/teamBImage"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        tools:src="@mipmap/ic_launcher_round"
                        bind:loadimage="@{model.team_b_img}"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/teamBName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Royal Challengers Banglore"
                        android:textAlignment="center"
                        android:layout_gravity="center"
                        android:text="@{model.team_b_name}"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:visibility="@{myvote==true ? View.GONE : View.VISIBLE}"
                android:id="@+id/selectLinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingRight="@dimen/_15sdp"
                    android:paddingLeft="@dimen/_15sdp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.20"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                    <RadioButton
                        android:id="@+id/teamARadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/colorPrimary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/teamASelect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.80"
                        tools:text="Gurjrat Titans"
                        android:singleLine="true"
                        android:text="@{model.team_a_name}"
                        android:textColor="@color/black"
                        android:background="@drawable/roung_unselected_bg"
                        style="@style/font_bold"
                        android:paddingLeft="@dimen/_20sdp"
                        android:paddingRight="@dimen/_20sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:paddingBottom="@dimen/_5sdp"/>

                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingRight="@dimen/_15sdp"
                    android:paddingLeft="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.20"
                        android:orientation="vertical"
                        android:layout_gravity="center"
                        android:gravity="center">
                    <RadioButton
                        android:id="@+id/teamBRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/colorPrimary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/teamBSelect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.80"
                        tools:text="Royal Chalangers Banglore"
                        android:singleLine="true"
                        android:text="@{model.team_b_name}"
                        android:textColor="@color/black"
                        android:background="@drawable/roung_unselected_bg"
                        style="@style/font_bold"
                        android:paddingLeft="@dimen/_20sdp"
                        android:paddingRight="@dimen/_20sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:paddingBottom="@dimen/_5sdp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingRight="@dimen/_15sdp"
                    android:paddingLeft="@dimen/_15sdp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.20"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <RadioButton
                            android:id="@+id/tieRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/colorPrimary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tieSelect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.80"
                        tools:text="Gurjrat Titans"
                        android:singleLine="true"
                        android:text="Tie"
                        android:textColor="@color/black"
                        android:background="@drawable/roung_unselected_bg"
                        style="@style/font_bold"
                        android:paddingLeft="@dimen/_20sdp"
                        android:paddingRight="@dimen/_20sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:paddingBottom="@dimen/_5sdp"/>

                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:visibility="@{myvote==true ? View.VISIBLE : View.GONE}"
                android:id="@+id/progressLinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/_15sdp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/teamAPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="50 %"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />

                    <ProgressBar
                        android:id="@+id/teamAProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_100sdp"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:progress="50"
                        android:progressDrawable="@drawable/progressbar"
                        android:rotation="180" />

                    <TextView
                        android:id="@+id/teamAShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="RR"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/teamBPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="30 %"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />


                    <ProgressBar
                        android:id="@+id/teamBProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_100sdp"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:progress="30"
                        android:progressDrawable="@drawable/progressbar"
                        android:rotation="180" />

                    <TextView
                        android:id="@+id/teamBShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="RCB"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tiePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="10 %"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />

                    <ProgressBar
                        android:id="@+id/tieProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_100sdp"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:progress="10"
                        android:progressDrawable="@drawable/progressbar"
                        android:rotation="180" />

                    <TextView
                        android:id="@+id/tieShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIE"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black" />

                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:visibility="@{myvote==true ? View.VISIBLE : View.GONE}"
                android:id="@+id/linearPoll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >

                <TextView
                    android:id="@+id/totalPoll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Total poll : 15"
                    android:layout_marginTop="@dimen/_5sdp"
                    style="@style/font_bold"
                    android:textColor="@color/black" />


                <TextView
                    android:id="@+id/yourVote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Your Vote : RCB"
                    android:layout_marginTop="@dimen/_5sdp"
                    style="@style/font_bold"
                    android:textColor="@color/colorAccent" />

            </LinearLayout>


            <Button
                android:visibility="@{myvote==true ? View.GONE : View.VISIBLE}"
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20sdp"
                android:background="@drawable/round_bg"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Submit"
                android:textColor="@color/white"
                style="@style/font_bold"/>



        </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:elevation="@dimen/_40sdp"
        android:indeterminateDrawable="@drawable/custom_progress" />

</RelativeLayout>
</layout>