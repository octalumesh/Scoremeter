<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkstatusbar1"
    tools:context=".ui.fragments.polls.PollsFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/indicator"
        tools:listitem="@layout/item_polls"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"/>

    <com.arindicatorview.ARIndicatorView
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        app:indicator_size="15"
        app:indicator_color="@color/gray"
        app:selected_color="@color/colorAccent"
        app:indicator_animation="@anim/zoom_in"
        app:indicator_shape="@drawable/round_bg"
        app:indicator_scrubbing="true"
        app:animate_indicator_scrubbing="true"
        />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/linearlayout_if_live_not_show_image"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginTop="50dp"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/ic_undraw_season_calender"
            />

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_livescorepage_upcomingdateshow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/font_regular"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:text="Come back soon"
                />

            <TextView
                android:visibility="gone"
                android:id="@+id/tv_livescorepage_upcomingdateshow"
                android:layout_toRightOf="@+id/tv_livescorepage_upcomingdateshow1"
                android:layout_marginLeft="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                style="@style/font_regular"
                android:text=""
                />

        </RelativeLayout>

    </LinearLayout>
   <!-- <com.rd.PageIndicatorView
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        app:piv_animationType="scale"
        app:piv_dynamicCount="true"
        app:piv_interactiveAnimation="true"
        app:piv_padding="4dp"
        app:piv_selectedColor="@color/colorAccent"
        app:piv_unselectedColor="#A2BFA2"
        app:piv_viewPager="@id/viewPage" />-->

</RelativeLayout>
</layout>