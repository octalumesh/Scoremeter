<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_color"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cardview_oddshistory"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:cardCornerRadius="10dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="@color/card_view_white">

        <RelativeLayout
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/linearLayout_oddshistory_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:fontFamily="@font/arial_semibold"
                    android:textSize="7sp"
                    android:text="Time"
                    android:layout_marginRight="3dp"
                    style="@style/font_regular"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_lgt_odds2"
                    android:layout_width="wrap_content" />

            <TextView
                android:id="@+id/oddsTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="11:00"
                style="@style/font_regular"
                android:textColor="@color/txt_color"
                android:textSize="10sp"
                />
            </LinearLayout>

<!--            <View-->
<!--                android:layout_width="@dimen/_20sdp"-->
<!--                android:layout_height="@dimen/_1sdp"-->
<!--                android:background="@color/gray"/>-->


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.20"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:fontFamily="@font/arial_semibold"
                android:textSize="11sp"
                android:text="Fav: "
                android:layout_gravity="center_vertical"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:textColor="@color/green_lgt_odds2"
                style="@style/font_regular"
                android:textStyle="bold"
                android:layout_width="wrap_content" />

            <TextView
                android:id="@+id/oddsTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                tools:text="RCB"
                android:textColor="@color/txt_color"
                style="@style/font_medium"
                tools:ignore="RtlCompat" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_odds_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/oddsMinRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="67"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                style="@style/font_medium"
                android:background="@drawable/shape_rate_rectangle"
                android:backgroundTint="@color/odds_max"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/oddsMaxRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="68"
                style="@style/font_medium"
                android:layout_marginLeft="@dimen/_5sdp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textColor="@color/black"
                android:background="@drawable/shape_rate_rectangle"
                android:backgroundTint="@color/odds_min"/>

        </LinearLayout>

    </LinearLayout>

            <TextView
                android:id="@+id/tv_lastball_cycle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="5dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:layout_below="@+id/linearLayout_oddshistory_main"
                style="@style/font_regular"
                android:textSize="10sp"
                android:text="-"
                android:textColor="@color/dark_black"
                android:background="@drawable/cricle_shape_round"
                android:backgroundTint="@color/tab_gray_lgt"/>



            <LinearLayout
                android:id="@+id/linearRuns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/linearLayout_oddshistory_main"
                android:layout_toRightOf="@+id/tv_lastball_cycle"
                android:layout_marginLeft="@dimen/_10sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/run_at_this_overball"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="181"
                    android:textAlignment="center"
                    android:layout_gravity="right"
                    android:textColor="@color/txt_color"
                    style="@style/font_medium"
                    tools:ignore="RtlCompat" />

                <TextView
                    android:fontFamily="@font/arial_semibold"
                    android:textSize="11sp"
                    android:text="  Runs, "
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_lgt_odds2"
                    style="@style/font_regular"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content" />

                <TextView
                    android:id="@+id/oddsOver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0.1"
                    style="@style/font_regular"
                    android:textSize="11sp"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/txt_color"
                    />

            </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/linearLayout_oddshistory_main"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:paddingTop="@dimen/_4sdp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/font_bold"
                    android:textSize="11sp"
                    android:text="Session"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:textColor="@color/green_lgt_odds2"
                    android:layout_width="wrap_content" />

                <RelativeLayout
                    android:id="@+id/relative_home_favteamxx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:backgroundTint="@color/green_lgt_odds"
                    android:background="@drawable/shape_rate_rectangle">

                    <TextView
                        android:id="@+id/oddsSMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        style="@style/font_regular"
                        android:textColor="@color/green_lgt_odds2"
                        android:textSize="13sp"
                        tools:text="44" />

                </RelativeLayout>

                <!--            <View-->
                <!--                android:layout_width="@dimen/_15sdp"-->
                <!--                android:layout_height="@dimen/_1sdp"-->
                <!--                android:background="@color/gray"/>-->

                <RelativeLayout
                    android:id="@+id/relative_home_favteamx2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:backgroundTint="@color/green_lgt_odds"
                    android:background="@drawable/shape_rate_rectangle">

                    <TextView
                        android:id="@+id/oddsSMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="45"
                        android:layout_centerHorizontal="true"
                        android:textColor="@color/green_lgt_odds2"
                        style="@style/font_regular"
                        android:textSize="13sp"
                        />
                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
<!--    <View-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="@dimen/_1sdp"-->
<!--        android:layout_marginTop="7dp"-->
<!--        android:background="@color/gray"/>-->

</LinearLayout>