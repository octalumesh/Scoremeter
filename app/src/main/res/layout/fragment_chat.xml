<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="FragmentChatBinding">

        <import type="android.view.View" />

        <variable
            name="islogin"
            type="Boolean" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        tools:context=".livedata.ui.fragment.ChatFragment">


        <!-- <androidx.cardview.widget.CardView
             android:visibility="@{islogin==true ? View.GONE : View.VISIBLE}"
             android:layout_marginTop="@dimen/_130sdp"
             android:id="@+id/cardchat"
             android:layout_width="match_parent"
             android:layout_marginRight="@dimen/_10sdp"
             android:layout_marginLeft="@dimen/_10sdp"
             app:cardCornerRadius="@dimen/_10sdp"
             app:cardBackgroundColor="@color/colorAccent"
             android:layout_height="wrap_content">

             <TextView

                 android:id="@+id/Tv_google_login"
                 android:layout_width="match_parent"
                 android:padding="@dimen/_5sdp"
                 android:layout_height="wrap_content"
                 android:textColor="@color/white"
                 android:textStyle="bold"
                 android:text="Login To Chat"
                 android:layout_gravity="center"
                 android:textAlignment="center"/>


         </androidx.cardview.widget.CardView>-->

        <TextView
            android:id="@+id/Tv_google_login"
            style="@style/font_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_130sdp"
            android:background="@drawable/gradiant_login"
            android:backgroundTint="@color/colorAccent"
            android:elevation="@dimen/_10sdp"
            android:gravity="center"
            android:paddingLeft="@dimen/_60sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingRight="@dimen/_60sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:text="Login To Chat"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:visibility="@{islogin==true ? View.GONE : View.VISIBLE}" />

        <RelativeLayout
            android:id="@+id/parent_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="@{islogin==true ? View.VISIBLE : View.GONE}">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:indeterminateDrawable="@drawable/custom_progress" />


            <RelativeLayout
                android:id="@+id/matchFinished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/matcNot"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_centerHorizontal="true"
                    app:tint="@color/gray"
                    android:src="@drawable/stopwatch" />

                <TextView
                    style="@style/font_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/matcNot"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Match Finished"
                    android:textColor="@color/black" />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/noMessageFound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/msgNot"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_baseline_message_24" />

                <TextView
                    style="@style/font_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/msgNot"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="No Messages Yet"
                    android:textColor="@color/black" />


            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/ll"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_10sdp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_chat_layout" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/corner_shape"
                android:backgroundTint="@color/white"
                android:elevation="@dimen/_15sdp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:padding="@dimen/_5sdp">

                <EditText
                    android:id="@+id/ET_textmsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_toLeftOf="@+id/sendbt"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:hint="Message"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:id="@+id/sendbt"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:src="@drawable/ic_baseline_send_24"
                    app:tint="@color/yellow_lgt" />
            </RelativeLayout>

        </RelativeLayout>


    </RelativeLayout>
</layout>