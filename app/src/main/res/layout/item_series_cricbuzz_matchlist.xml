<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="ItemSeriesMatchListCricbuzzBinding">

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_color"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/matchParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:background="@color/card_view_white"
            android:orientation="vertical"
            android:paddingHorizontal="0dp"
            android:paddingTop="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">


                <TextView
                    android:id="@+id/textview_match_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="10dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    style="@style/font_regular"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Loading.."
                    android:textColor="@color/txt_lgt"
                    android:textSize="12sp" />


            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/rerlative_team1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.40"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/teamAImage"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_gravity="center"
                                android:src="@drawable/viratone" />

                            <TextView
                                android:id="@+id/teamAName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/_4sdp"
                                style="@style/font_regular"
                                android:maxLength="13"
                                android:maxLines="2"
                                android:textColor="@color/txt_color"
                                android:textSize="14sp"
                                tools:text="IND" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/teamAScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_weight="0.60"
                            style="@style/font_bold"
                            android:textColor="@color/txt_color"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="105-7" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rerlative_team2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rerlative_team1"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.40"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/teamBImage"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center"
                                android:src="@drawable/virat" />

                            <TextView
                                android:id="@+id/teamBName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/_4sdp"
                                style="@style/font_regular"
                                android:maxLength="13"
                                android:maxLines="2"
                                android:textColor="@color/txt_color"
                                android:textSize="14sp"
                                tools:text="AUS" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/teamBScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_weight="0.60"
                            style="@style/font_bold"
                            android:textColor="@color/txt_color"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="105-7" />


                    </LinearLayout>

                </RelativeLayout>


            </LinearLayout>


            <TextView
                android:id="@+id/resultVanue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                style="@style/font_regular"
                android:text="@string/point_table"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:textColor="@color/txt_color"
                android:textSize="14sp" />

        </LinearLayout>

        <!--    </androidx.cardview.widget.CardView>-->

    </LinearLayout>
</layout>