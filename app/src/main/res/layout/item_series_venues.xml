<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="ItemSeriesVenuesCricBinding">

    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_color"
        android:orientation="vertical">


        <RelativeLayout
            android:id="@+id/parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_view_white"
            android:padding="@dimen/_5sdp">

            <ImageView
                android:id="@+id/venueImg"
                android:layout_width="@dimen/_75sdp"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginLeft="@dimen/_10sdp"
                android:src="@drawable/stadium_venue"/>

            <TextView
                android:id="@+id/venueName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_toRightOf="@id/venueImg"
                android:ellipsize="end"
                style="@style/font_regular"
                android:maxLines="2"
                android:textColor="@color/txt_color"
                android:textSize="15sp"
                tools:text="fgfdg" />


            <TextView
                android:id="@+id/venueCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/venueImg"
                android:layout_below="@id/venueName"
                android:layout_marginLeft="@dimen/_5sdp"
                tools:text="fgfdg"
                android:maxLines="2"
                android:ellipsize="end"
                style="@style/font_regular"
                android:textColor="@color/txt_lgt"
                android:textSize="15sp" />


        </RelativeLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_view" />

    </LinearLayout>

</layout>