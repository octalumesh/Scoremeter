<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="UserProfileActivityBinding">

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".livedata.ui.activity.UserProfileActivity">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:background="@color/colorAccent"
                android:padding="@dimen/_5sdp">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/_40sdp"
                    style="@style/font_bold"
                    android:text="Profile"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/gradiant_login"
                    android:backgroundTint="@color/colorAccent"
                    android:drawableLeft="@drawable/ic_baseline_logout"
                    android:drawableTint="@color/white"
                    android:drawablePadding="@dimen/_5sdp"
                    android:elevation="@dimen/_10sdp"
                    style="@style/font_bold"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_4sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_4sdp"
                    android:text="Log Out"
                    android:textColor="@color/white"
                    android:textSize="13sp" />


            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/carview_expert_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                app:cardBackgroundColor="@color/card_view_white"
                app:cardCornerRadius="@dimen/_4sdp"
                app:cardElevation="8dp"
                app:cardMaxElevation="1dp"
                app:cardPreventCornerOverlap="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/_5sdp"
                        android:paddingLeft="@dimen/_10sdp">


                        <FrameLayout
                            android:id="@+id/frameImg"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/image"
                                android:layout_width="@dimen/_45sdp"
                                android:layout_height="@dimen/_45sdp"
                                android:src="@mipmap/ic_launcher_round"
                                app:civ_border_color="@color/yellow_lgt"
                                app:civ_border_width="1dp" />

                            <ImageView
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:src="@drawable/camera_icon"
                                android:layout_gravity="bottom|end"/>


                        </FrameLayout>


                        <TextView
                            android:id="@+id/edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/frameImg"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:background="@drawable/gradiant_round"
                            android:backgroundTint="@color/colorAccent"
                            android:visibility="gone"
                            android:drawableLeft="@drawable/ic_baseline_edit_24"
                            android:drawablePadding="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:gravity="center"
                            android:paddingLeft="@dimen/_8sdp"
                            android:paddingTop="@dimen/_2sdp"
                            android:paddingRight="@dimen/_8sdp"
                            android:paddingBottom="@dimen/_2sdp"
                            android:text="Edit"
                            android:textColor="@color/yellow_lgt"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_toLeftOf="@id/withdrawMoney"
                            android:layout_toRightOf="@id/frameImg"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/userName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/font_bold"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="Accurate Prediction" />

                            <TextView
                                android:id="@+id/points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/font_regular"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="234 Pts" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/withdrawMoney"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="@dimen/_15sdp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:src="@drawable/ic_baseline_account_balance_wallet_24" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/font_regular"
                                android:text="Wallet"
                                android:textColor="@color/black"
                                android:textSize="13sp" />


                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/accuracyLinear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="@dimen/_15sdp"
                            android:foregroundGravity="center_vertical"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_40sdp">

                                <ProgressBar
                                    android:id="@+id/progressBar"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="@dimen/_40sdp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/circle_shape"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progressDrawable="@drawable/circular_progress_bar"
                                    tools:progress="58" />

                                <TextView
                                    android:id="@+id/progress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="0%"
                                    android:textColor="@color/dark_black"
                                    android:textSize="10sp" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/font_regular"
                                android:gravity="center"
                                android:text="Accuracy"
                                android:textColor="@color/black"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/yellow_lgt" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gradiant_bg"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_3sdp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_bold"
                                    android:gravity="center"
                                    android:text="Toss"
                                    android:textColor="@color/yellow_lgt" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:layout_marginRight="@dimen/_3sdp"
                                android:background="@color/yellow_lgt" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_3sdp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_bold"
                                    android:gravity="center"
                                    android:text="Match"
                                    android:textColor="@color/yellow_lgt" />

                            </LinearLayout>


                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/yellow_lgt" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_4sdp">

                                <TextView
                                    android:id="@+id/winTossPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_regular"
                                    android:gravity="center"
                                    android:text="0%"
                                    android:textColor="@color/black" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:layout_marginRight="@dimen/_3sdp"
                                android:background="@color/yellow_lgt" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_4sdp">

                                <TextView
                                    android:id="@+id/winMatchPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_regular"
                                    android:gravity="center"
                                    android:text="0%"
                                    android:textColor="@color/black" />

                            </LinearLayout>


                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/yellow_lgt" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_4sdp">

                                <TextView
                                    android:id="@+id/winTotalToss"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_regular"
                                    android:gravity="center"
                                    android:text="0/0"
                                    android:textColor="@color/black" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:layout_marginRight="@dimen/_3sdp"
                                android:background="@color/yellow_lgt" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/_4sdp">

                                <TextView
                                    android:id="@+id/winTotalMatch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/font_regular"
                                    android:gravity="center"
                                    android:text="0/0"
                                    android:textColor="@color/black" />

                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/amount_dis_first">


                            <TextView
                                android:id="@+id/totalAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/font_bold"
                                android:gravity="center"
                                android:text="Total Amount\n (564756)"
                                android:textColor="@color/white" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/amount_dis_first">

                            <TextView
                                android:id="@+id/referEarn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/font_bold"
                                android:gravity="center"
                                android:text="Refer &amp; Earn"
                                android:textColor="@color/white" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/amount_dis_second"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/matchZonePass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/font_bold"
                                android:gravity="center"
                                android:text="Zone 1 match \n(No Zone pass)"
                                android:textColor="@color/white" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/amount_dis_second"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tossZonePass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/font_bold"
                                android:gravity="center"
                                android:text="Zone 1 toss \n(No Zone pass)"
                                android:textColor="@color/white" />


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:background="@color/colorAccent"
                    app:layout_scrollFlags="scroll"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/tab_indicate_yelow_mild"
                    app:tabIndicatorHeight="2dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/text_white"
                    app:tabSelectedTextColor="@color/text_white"
                    app:tabTextAppearance="@style/tab_text_font"
                    app:tabTextColor="@color/tab_gray_lgt"
                    app:tabUnboundedRipple="true" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>


        </LinearLayout>


        <include
            android:id="@+id/progress_layout"
            layout="@layout/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </RelativeLayout>
</layout>
