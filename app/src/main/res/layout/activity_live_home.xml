<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data
        class="LiveHomeBinding">
    </data>

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".livedata.ui.activity.LiveHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorAccent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:layout_marginLeft="@dimen/_5sdp"/>

            <TextView
                android:id="@+id/teams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Aus v/s Ind"
                android:layout_toRightOf="@id/back"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_toLeftOf="@id/moreMatch"
                android:textColor="@color/white"
                android:layout_gravity="center"
                style="@style/font_medium"
                android:textSize="18sp"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_marginLeft="@dimen/_20sdp"/>



            <ImageView
                android:id="@+id/moreMatch"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/ic_baseline_arrow_drop_down_24"
                app:tint="@color/white"
                android:layout_toLeftOf="@id/liNotify"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_20sdp"/>

            <LinearLayout
                android:id="@+id/liNotify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/menu"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:layout_marginRight="@dimen/_20sdp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pinMatch"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_baseline_push_pin_24"
                    app:tint="@color/white"
                    android:layout_marginRight="@dimen/_10sdp"
                    />

                <ImageView
                    android:id="@+id/notification"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_baseline_notifications_none_24"
                    app:tint="@color/white"/>


            </LinearLayout>

            <ImageView
                android:id="@+id/menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_more_horiz_24"
                android:rotation="90"
                app:tint="@color/white"
                android:padding="@dimen/_5sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_10sdp"/>

        </RelativeLayout>




        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorAccent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            app:layout_scrollFlags="scroll"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/tab_indicate_yelow_mild"
            app:tabIndicatorHeight="2dp"
            app:tabMode="scrollable"
            app:tabRippleColor="#B5D1F4"
            app:tabSelectedTextColor="@color/text_white"
            app:tabTextAppearance="@style/tab_text_font"
            app:tabTextColor="@color/tab_gray_lgt"
            app:tabUnboundedRipple="true"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
    </LinearLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatbtn_pinscore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="@dimen/_50sdp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/yellow_lgt"
        android:clickable="true"
        android:visibility="gone"
        android:src="@drawable/ic_baseline_push_pin_24"
        android:tint="@color/black"
        android:rotation="30"
        app:borderWidth="0dp"
        app:fabSize="auto"
        app:pressedTranslationZ="12dp" />



    <include
        android:id="@+id/progress_layout"
        layout="@layout/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>
</layout>