<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data class="ItemPredictionListLayoutBinding">


    </data>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/darkstatusbar1"
    android:orientation="vertical">



    <LinearLayout
        android:id="@+id/parentUpcoming"
        android:background="@drawable/shape_rectangle"
        android:backgroundTint="@color/white"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:paddingTop="0dp"
        android:paddingHorizontal="0dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_marginBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <TextView
                android:id="@+id/textview_match_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="10dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                style="@style/font_regular"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Loading.."
                android:textColor="@color/black"
                android:textSize="12sp" />


        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65">

                <LinearLayout
                    android:id="@+id/rerlative_team1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:orientation="horizontal">


                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/team_image_a"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/viratone"
                        android:layout_gravity="center"
                        app:civ_border_color="@color/gray"
                        app:civ_border_width="0dp" />

                    <TextView
                        android:id="@+id/textview_team_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_4sdp"
                        style="@style/font_bold"
                        android:maxLength="13"
                        android:layout_gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/darkstatusbar_teamname"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="IND" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rerlative_team2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rerlative_team1"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/team_image_b"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:src="@drawable/virat"
                        app:civ_border_color="@color/gray"
                        app:civ_border_width="0dp" />

                    <TextView
                        android:id="@+id/textview_team_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_4sdp"
                        style="@style/font_bold"
                        android:maxLength="13"
                        android:layout_gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/darkstatusbar_teamname"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="AUS" />


                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.35">

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_centerVertical="true"
                    android:background="@color/gray" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/textview_match_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginRight="10dp"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        style="@style/font_bold"
                        android:gravity="center_horizontal"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:text="T20" />

                    <TextView
                        android:id="@+id/textview_date_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginRight="10dp"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        style="@style/font_bold"
                        android:gravity="center_horizontal"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        tools:text="Loading.." />

                </LinearLayout>


            </RelativeLayout>


        </LinearLayout>


        <RelativeLayout
            android:id="@+id/relative_recyclerview_predict_odds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@color/colorAccent"
            android:foregroundGravity="center_vertical"
            android:padding="@dimen/_3sdp">

            <TextView
                android:id="@+id/myTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/_5sdp"
                style="@style/font_regular"
                tools:text="IND"
                android:textColor="@color/white"
                android:textSize="12sp" />



            <TextView
                android:id="@+id/textview_pass_fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginRight="@dimen/_5sdp"
                style="@style/font_bold"
                tools:text="Pass"
                android:gravity="end"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/white"
                />
        </RelativeLayout>


    </LinearLayout>


</LinearLayout>
</layout>