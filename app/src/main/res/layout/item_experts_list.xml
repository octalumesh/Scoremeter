    <data class="ItemExpertsListBinding">


    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topParent"
        android:background="@color/darkstatusbar1"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray"/>

        <LinearLayout
            android:id="@+id/parentExperts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:padding="@dimen/_5sdp">


            <LinearLayout
                android:id="@+id/rerlative_team1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.60"
                android:layout_marginLeft="@dimen/_5sdp"
                android:orientation="horizontal">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/expertProfile"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    app:civ_border_color="@color/gray"
                    app:civ_border_width="0dp"
                    tools:src="@mipmap/ic_launcher_round" />

                <TextView
                    android:id="@+id/expertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_4sdp"
                    style="@style/font_bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    tools:text="IND" />


            </LinearLayout>

            <TextView
                android:id="@+id/points"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.20"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginLeft="@dimen/_4sdp"
                style="@style/font_bold"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="0" />

            <TextView
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.20"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:gravity="end"
                android:textSize="14sp"
                tools:text="0%" />


        </LinearLayout>


