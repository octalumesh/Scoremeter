<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="ItemTeamRankingCricBuzzBinding">

    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_view_white"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.15"
                style="@style/font_regular"
                android:gravity="center"
                android:textColor="@color/txt_color"
                android:textSize="16sp"
                tools:text="1" />

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.55">


                <ImageView
                    android:id="@+id/teamImg"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:scaleType="fitXY"
                    tools:src="@mipmap/ic_launcher_round" />


                <TextView
                    android:id="@+id/teamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_toRightOf="@id/teamImg"
                    android:ellipsize="end"
                    style="@style/font_regular"
                    android:singleLine="true"
                    android:text="gfdgdfgfdgfd"
                    android:textColor="@color/txt_color"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/teamMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/teamName"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_toRightOf="@id/teamImg"
                    android:ellipsize="end"
                    style="@style/font_regular"
                    android:singleLine="true"
                    android:text="gfdgdfgfdgfd"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />


            </RelativeLayout>

            <TextView
                android:id="@+id/rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.20"
                style="@style/font_regular"
                android:gravity="center"
                android:textColor="@color/gray"
                android:textSize="16sp"
                tools:text="100" />

            <TextView
                android:id="@+id/points"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.20"
                style="@style/font_regular"
                android:gravity="center"
                android:textColor="@color/gray"
                android:textSize="16sp"
                tools:text="100" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_view" />

    </LinearLayout>

</layout>