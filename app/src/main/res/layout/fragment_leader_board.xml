                        <TextView
                            android:id="@+id/firstZonePriceToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp"
                            tools:text="Safe zone 1 => 7 Toss Pass =11000/-" />

                        <TextView
                            android:id="@+id/firstZonePassToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:visibility="gone"
                            android:text="You have successfully clear 1st zone"
                            android:textColor="#117C00"
                            android:textSize="@dimen/_11sdp" />

                    </LinearLayout>


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlSecondToss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckSecondToss"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckSecondToss">

                        <TextView
                            android:id="@+id/secondZonePriceToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 2 => 15 Toss Pass =11000/-"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/secondZonePassToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:text="You have successfully clear 2nd zone"
                            android:textColor="#117C00"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlThirdToss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckThirdToss"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckThirdToss">

                        <TextView
                            android:id="@+id/thirdZonePriceToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 3 => 20 Toss Pass =11000/-"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/thirdZonePassToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:text="You have successfully clear 3rd zone"
                            android:textColor="#117C00"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/rlFourthToss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckFourthToss"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckFourthToss">

                        <TextView
                            android:id="@+id/fourthZonePriceToss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 4 => 25 Toss Pass =11000/-"
