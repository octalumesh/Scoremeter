                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 4 => 25 Match Pass =11000/-"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/fourthZonePassMatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:text="You have successfully clear 4th zone"
                            android:textColor="#117C00"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                </RelativeLayout>


            </LinearLayout>


            <LinearLayout
                android:id="@+id/tossList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rlFirstToss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_gradiant_green">


                    <ImageView
                        android:id="@+id/checkUncheckFirstToss"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_baseline_check_circle_24" />


                    <LinearLayout
