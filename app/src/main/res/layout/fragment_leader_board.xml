<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".livedata.ui.fragment.profile.LeaderBoardFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerSwitch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/shape_rect_expert"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_1sdp">


                <TextView
                    android:id="@+id/tossExperts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_rectangle"
                    android:backgroundTint="@color/colorAccent"
                    android:gravity="center"
                    android:text="Toss Winner"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/matchExperts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_rectangle"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="Match Winner"
                    android:textAllCaps="false"
                    android:textColor="@color/black" />




            </LinearLayout>

            <LinearLayout
                android:id="@+id/matchList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rlFirstMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_gradiant_green">


                    <ImageView
                        android:id="@+id/checkUncheckFirstMatch"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_baseline_check_circle_24" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckFirstMatch">

                    <TextView
                        android:id="@+id/firstZonePriceMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        style="@style/font_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp"
                        tools:text="Safe zone 1 => 7 Match Pass =11000/-" />

                    <TextView
                        android:id="@+id/firstZonePassMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        style="@style/font_bold"
                        android:visibility="gone"
                        android:text="You have successfully clear 1st zone"
                        android:textColor="#117C00"
                        android:textSize="@dimen/_11sdp" />

                    </LinearLayout>


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlSecondMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckSecondMatch"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckSecondMatch">

                        <TextView
                            android:id="@+id/secondZonePriceMatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 2 => 15 Match Pass =11000/-"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/secondZonePassMatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:text="You have successfully clear 2nd zone"
                            android:textColor="#117C00"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlThirdMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckThirdMatch"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckThirdMatch">

                        <TextView
                            android:id="@+id/thirdZonePriceMatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_3sdp"
                            style="@style/font_bold"
                            tools:text="Safe zone 3 => 20 Match Pass =11000/-"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/thirdZonePassMatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_marginBottom="@dimen/_3sdp"
                            style="@style/font_bold"
                            android:text="You have successfully clear 3rd zone"
                            android:textColor="#117C00"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/rlFourthMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/leaderboard_unselect">

                    <ImageView
                        android:id="@+id/checkUncheckFourthMatch"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:elevation="@dimen/_5sdp"
                        android:src="@drawable/ic_baseline_cancel_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@+id/checkUncheckFourthMatch">

                        <TextView
