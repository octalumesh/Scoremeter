<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <TextView
        android:visibility="gone"
        android:id="@+id/textview_count_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="20dp"
        android:paddingLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:drawableLeft="@drawable/ic_baseline_play_arrow_24"
        android:drawableTint="@color/black"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/arial_semibold"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        />


    <TextView
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:id="@+id/textview_match_type"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:background="@drawable/corner_shape"
        android:backgroundTint="@color/gray_lgt"
        android:layout_marginLeft="-4dp"
        android:layout_marginTop="-1dp"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/card_view_white"/>


    <LinearLayout
        android:id="@+id/parentUpcoming"
        android:background="@drawable/shape_rectangle"
        android:backgroundTint="@color/white"
        android:layout_marginHorizontal="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:layout_marginTop="@dimen/_3sdp"
        android:paddingTop="0dp"
        android:paddingHorizontal="0dp"
        android:paddingBottom="4dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_marginBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/upcomingMatchType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="ODI" />

            <TextView
                android:id="@+id/textview_match_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/upcomingMatchType"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="10dp"
                android:visibility="gone"
                android:fontFamily="@font/arial_semibold"
                android:text="Loading.."
                android:textColor="@color/black"
                android:textSize="12sp" />

            <!--                <TextView-->
            <!--                    android:layout_alignParentRight="true"-->
            <!--                    android:id="@+id/textview_matchdate"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:textSize="12sp"-->
            <!--                    android:textColor="?attr/textColor" />-->

        </RelativeLayout>

        <!--            <include layout="@layout/item_divider"-->
        <!--                android:layout_height="1dp"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_gravity="center_horizontal"-->
        <!--                tools:ignore="IncludeLayoutParam" />-->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rerlative_team1"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="20dp"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/teamaCard"
                    android:layout_width="@dimen/_45sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardBackgroundColor="@color/white">

                    <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/team_image_a_live"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/viratone"
                        app:civ_border_color="@color/gray"
                        app:civ_border_width="0dp" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textview_team_a_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/teamaCard"
                    android:layout_centerInParent="true"
                    style="@style/font_bold"
                    android:maxLength="13"
                    android:maxLines="2"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/textview_vs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_baseline_offline_bolt_24"
                android:backgroundTint="@color/gray"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textview_matchdetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textview_vs"
                android:layout_marginTop="5dp"
                android:layout_toLeftOf="@id/teambRelative"
                android:layout_toRightOf="@id/rerlative_team1"
                android:fontFamily="@font/arial_semibold"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textview_count_predictions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textview_matchdetail"
                android:layout_toLeftOf="@id/teambRelative"
                android:layout_toRightOf="@id/rerlative_team1"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center"
                android:fontFamily="@font/arial_semibold"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textview_cvs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textview_count_predictions"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_toLeftOf="@id/teambRelative"
                android:layout_toRightOf="@id/rerlative_team1"
                android:fontFamily="@font/arial_semibold"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="VS"
                android:textColor="@color/black"
                android:textSize="15sp" />


            <RelativeLayout
                android:id="@+id/teambRelative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="20dp">

                <TextView
                    android:id="@+id/textview_team_b_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/teambcard"
                    android:layout_centerHorizontal="true"
                    style="@style/font_bold"
                    android:maxLength="10"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/teambcard"
                    android:layout_width="@dimen/_45sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/team_image_b_live"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/virat"
                        app:civ_border_color="@color/gray"
                        app:civ_border_width="0dp" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

        </RelativeLayout>

        <include layout="@layout/item_divider"
            android:layout_height="1dp"
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            tools:ignore="IncludeLayoutParam" />

        <TextView
            android:id="@+id/textview_venue_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:paddingRight="12dp"
            android:paddingLeft="7dp"
            android:visibility="gone"
            android:layout_marginVertical="3dp"
            android:layout_centerHorizontal="true"
            style="@style/font_bold"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            />
    </LinearLayout>


</LinearLayout>