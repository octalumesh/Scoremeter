<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".livedata.ui.fragment.ranking.BowlingWomensFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/shape_rect_green"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/odiRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_rect_green"
                android:backgroundTint="@color/txt_title"
                style="@style/font_regular"
                android:paddingLeft="@dimen/_11sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingRight="@dimen/_11sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:text="ODI"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/t20Rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_rect_green"
                style="@style/font_regular"
                android:paddingLeft="@dimen/_11sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingRight="@dimen/_11sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:text="T20"
                android:textAllCaps="false"
                android:textColor="@color/colorAccent"
                android:textSize="16sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@color/green_table"
            android:padding="@dimen/_5sdp">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rank"
                android:paddingLeft="@dimen/_5sdp"
                android:textSize="16sp"
                style="@style/font_regular"
                android:textColor="@color/gray_dark"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Player"
                android:textSize="16sp"
                style="@style/font_regular"
                android:textColor="@color/gray_dark"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Points"
                android:textSize="16sp"
                android:gravity="end"
                android:paddingRight="@dimen/_8sdp"
                style="@style/font_regular"
                android:textColor="@color/gray_dark"
                />


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:listitem="@layout/item_players_ranking_cricbuzz"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>


    </LinearLayout>


    <include
        android:id="@+id/progress_layout"
        layout="@layout/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>