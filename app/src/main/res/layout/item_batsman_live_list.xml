<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data class="ItemBatsmanLiveBinding">

    </data>
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/relative_livepage2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textview_batsman_name1"
            android:textSize="12sp"
            android:text="--"
            tools:text="fgfg"
            style="@style/font_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:textColor="@color/gray_scrbordbtn_act"/>


        <RelativeLayout
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textview_batsman_details1_scoreboard_run_live"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="--"
                style="@style/font_bold"
                android:textAlignment="center"
                android:gravity="center_horizontal"
                android:textColor="@color/gray_scrbordbtn_act" />

            <TextView
                android:id="@+id/textview_batsman_details1_scoreboard_ball_live"
                android:layout_toRightOf="@id/textview_batsman_details1_scoreboard_run_live"
                android:layout_width="27dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="--"
                android:layout_centerVertical="true"
                style="@style/font_medium"
                android:textAlignment="center"
                android:gravity="center_horizontal"
                android:textColor="@color/gray_scrbordbtn_act" />

            <TextView
                android:id="@+id/textview_batsman_details1_scoreboar_4s_live"
                android:layout_toRightOf="@id/textview_batsman_details1_scoreboard_ball_live"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text=""
                style="@style/font_medium"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                android:gravity="center_horizontal"
                android:textColor="@color/gray_scrbordbtn_act" />

            <TextView
                android:id="@+id/textview_batsman_details1_scoreboard_6s_live"
                android:layout_toRightOf="@id/textview_batsman_details1_scoreboar_4s_live"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="--"
                style="@style/font_medium"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                android:gravity="center_horizontal"
                android:textColor="@color/gray_scrbordbtn_act" />

            <TextView
                android:id="@+id/textview_batsman_details1_scoreboard_strate_live"
                android:layout_toRightOf="@id/textview_batsman_details1_scoreboard_6s_live"
                android:layout_width="37dp"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:text="--"
                style="@style/font_medium"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                android:gravity="center_horizontal"
                android:textColor="@color/gray_scrbordbtn_act" />

        </RelativeLayout>
    </RelativeLayout>

    <include
        android:id="@+id/include_divider0"
        layout="@layout/item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/relative_livepage2"
        android:layout_marginVertical="4dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp" />

</RelativeLayout>
</layout>