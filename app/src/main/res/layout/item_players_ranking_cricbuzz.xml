<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data class="ItemPlayerRankingCricBuzzBinding">

    </data>


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_view_white"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"

            android:orientation="horizontal">


            <TextView
                android:id="@+id/rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.15"
                style="@style/font_regular"
                tools:text="1"
                android:gravity="center"
                android:layout_gravity="center"
                android:textColor="@color/txt_color"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.75">

                <ImageView
                    android:id="@+id/trend"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    tools:src="@drawable/ic_baseline_stable"
                    android:layout_centerVertical="true"
                    app:tint="@color/txt_color"/>


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/playerImg"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_toRightOf="@id/trend"
                    android:layout_marginLeft="@dimen/_3sdp"
                    tools:src="@mipmap/ic_launcher_round"/>


                <TextView
                    android:id="@+id/playerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_regular"
                    android:text="gfdgdfgfdgfd"
                    android:layout_toRightOf="@id/playerImg"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/txt_color"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/playerCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_regular"
                    android:text="gfdgdfgfdgfd"
                    android:layout_toRightOf="@id/playerImg"
                    android:layout_below="@id/playerName"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />


            </RelativeLayout>

            <TextView
                android:id="@+id/points"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.20"
                style="@style/font_regular"
                android:gravity="end"
                tools:text="100"
                android:paddingRight="@dimen/_10sdp"
                android:layout_gravity="center"
                android:textColor="@color/gray"
                android:textSize="16sp" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_view"/>

    </LinearLayout>

</layout>