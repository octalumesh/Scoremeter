<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5D3DE"
    tools:context=".livedata.ui.fragment.experts.TopExpertsFragment">


    <LinearLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/linearlayout_livescorepage_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/_1sdp">


            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar_collpsing_toolbar_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FEDFE5"
                android:fitsSystemWindows="true"
                android:theme="@style/AppTheme">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collpsing_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fitsSystemWindows="true"
                    app:contentScrim="#FEDFE5"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed"
                    app:title="LIVE Score">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_270sdp"
                            android:background="@drawable/expert_top_bg"/>


                        <LinearLayout
                            android:id="@+id/headerSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_15sdp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:background="@drawable/shape_rect_expert"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="@dimen/_1sdp">

                            <TextView
                                android:id="@+id/tossExperts"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:background="@drawable/shape_rectangle"
                                android:backgroundTint="@color/colorPrimary"
                                android:gravity="center"
                                android:text="@string/experts_toss"
                                android:textAllCaps="false"
                                android:textColor="@color/white" />

                            <TextView
                                android:id="@+id/matchExperts"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:background="@drawable/shape_rectangle"
                                android:backgroundTint="@color/white"
                                android:gravity="center"
                                android:text="@string/experts_match"
                                android:textAllCaps="false"
                                android:textColor="@color/black" />


                        </LinearLayout>


                        <RelativeLayout
                            android:id="@+id/firstBelowLinear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/headerSwitch"
                            android:layout_centerHorizontal="true"
                            android:orientation="vertical">


                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/firstExpertImage"
                                android:layout_width="@dimen/_55sdp"
                                android:layout_height="@dimen/_55sdp"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:src="@mipmap/ic_launcher_round"
                                app:civ_border_color="@color/white"
                                app:civ_border_width="@dimen/_1sdp" />


                            <TextView
                                android:id="@+id/firstExpertName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/firstExpertImage"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:ellipsize="end"
                                android:fontFamily="@font/sora_medioum"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="User Name" />

                            <LinearLayout
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_145sdp"
                                android:layout_below="@+id/firstExpertName"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:background="@drawable/expert_build_one"
                                android:elevation="@dimen/_10sdp"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/_25sdp"
                                    android:layout_height="@dimen/_25sdp"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/_1sdp"
                                    android:elevation="@dimen/_10sdp"
                                    android:src="@drawable/star_build" />


                                <TextView
                                    android:id="@+id/firstExpertPoints"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:textSize="13sp"
                                    tools:text="1200 Pts." />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:text="Accuracy"
                                    android:textColor="@color/black"
                                    android:textSize="11sp" />


                                <TextView
                                    android:id="@+id/firstExpertAccuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@drawable/round_bg"
                                    android:backgroundTint="#3B3838"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/_10sdp"
                                    android:paddingRight="@dimen/_10sdp"
                                    android:text="0%"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />


                            </LinearLayout>

                        </RelativeLayout>


                        <LinearLayout
                            android:id="@+id/secondBelowLinear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/headerSwitch"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:layout_toLeftOf="@id/firstBelowLinear"
                            android:orientation="vertical">


                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/secondExpertImage"
                                android:layout_width="@dimen/_55sdp"
                                android:layout_height="@dimen/_55sdp"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:src="@mipmap/ic_launcher_round"
                                app:civ_border_color="@color/white"
                                app:civ_border_width="@dimen/_1sdp" />


                            <TextView
                                android:id="@+id/secondExpertName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:ellipsize="end"
                                android:fontFamily="@font/sora_medioum"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="User Name" />

                            <LinearLayout
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_130sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:background="@drawable/expert_build_two"
                                android:elevation="@dimen/_10sdp"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/_25sdp"
                                    android:layout_height="@dimen/_25sdp"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/_1sdp"
                                    android:elevation="@dimen/_10sdp"
                                    android:src="@drawable/star_build" />


                                <TextView
                                    android:id="@+id/secondExpertPoints"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:textSize="13sp"
                                    tools:text="1200 Pts." />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:text="Accuracy"
                                    android:textColor="@color/black"
                                    android:textSize="11sp" />


                                <TextView
                                    android:id="@+id/secondExpertAccuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@drawable/round_bg"
                                    android:backgroundTint="#3B3838"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/_10sdp"
                                    android:paddingRight="@dimen/_10sdp"
                                    android:text="0%"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/thirdBelowLinear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/headerSwitch"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:layout_toRightOf="@id/firstBelowLinear"
                            android:orientation="vertical">


                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/thirdExpertImage"
                                android:layout_width="@dimen/_55sdp"
                                android:layout_height="@dimen/_55sdp"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:src="@mipmap/ic_launcher_round"
                                app:civ_border_color="@color/white"
                                app:civ_border_width="@dimen/_1sdp" />


                            <TextView
                                android:id="@+id/thirdExpertName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:ellipsize="end"
                                android:fontFamily="@font/sora_medioum"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="User Name" />

                            <LinearLayout
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_125sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:background="@drawable/expert_build_three"
                                android:elevation="@dimen/_10sdp"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/_25sdp"
                                    android:layout_height="@dimen/_25sdp"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:elevation="@dimen/_10sdp"
                                    android:src="@drawable/star_build" />


                                <TextView
                                    android:id="@+id/thirdExpertPoints"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:textSize="13sp"
                                    tools:text="1200 Pts." />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:text="Accuracy"
                                    android:textColor="@color/black"
                                    android:textSize="11sp" />


                                <TextView
                                    android:id="@+id/thirdExpertAccuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@drawable/round_bg"
                                    android:backgroundTint="#3B3838"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_medioum"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/_10sdp"
                                    android:paddingRight="@dimen/_10sdp"
                                    android:text="0%"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />


                            </LinearLayout>

                        </LinearLayout>

                    </RelativeLayout>


                </com.google.android.material.appbar.CollapsingToolbarLayout>

            </com.google.android.material.appbar.AppBarLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_round_bg_top"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:orientation="horizontal"
                    android:padding="@dimen/_5sdp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:layout_weight="0.60"
                        android:fontFamily="@font/sora_medioum"
                        android:text="User Name"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:layout_weight="0.20"
                        android:fontFamily="@font/sora_medioum"
                        android:gravity="center"
                        android:text="Points"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:layout_weight="0.20"
                        android:fontFamily="@font/sora_medioum"
                        android:text="Accuracy"
                        android:textColor="@color/white"
                        android:textSize="13sp" />


                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerExperts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_experts_list" />


                    <LinearLayout
                        android:id="@+id/linearlayout_if_live_not_show_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:src="@drawable/ic_undraw_season_calender" />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/tv_livescorepage_upcomingdateshow1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:text="Come back soon"
                                android:textColor="@color/black"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_livescorepage_upcomingdateshow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="7dp"
                                android:layout_toRightOf="@+id/tv_livescorepage_upcomingdateshow1"
                                android:fontFamily="@font/sora_light"
                                android:text=""
                                android:textSize="10sp"
                                android:visibility="gone" />

                        </RelativeLayout>

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>







    </LinearLayout>


    <include
        android:id="@+id/progress_layout"
        layout="@layout/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>