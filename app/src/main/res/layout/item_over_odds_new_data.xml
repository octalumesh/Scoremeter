<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data
        class="ItemOddsOverLayoutBinding">

    </data>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/shape_rectangle"
    android:backgroundTint="@color/card_view_white"
    android:orientation="vertical"
    android:elevation="@dimen/_2sdp">

    <RelativeLayout
        android:id="@+id/relative_odds_over"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/overData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_color"
            android:textSize="14sp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_5sdp"
            style="@style/font_regular"
            tools:text="10th Over"/>

        <ImageView
            android:id="@+id/dropdown"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_baseline_arrow_drop_down_24"
            app:tint="@color/txt_color"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="@dimen/_10sdp"/>

        <ImageView
            android:id="@+id/dropdownUp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_baseline_arrow_drop_up_24"
            app:tint="@color/txt_color"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:layout_marginRight="@dimen/_10sdp"/>

    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOverOdds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:reverseLayout="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_odds_inside"
        tools:itemCount="6"
        android:layout_below="@id/overData"
        android:layout_marginTop="@dimen/_5sdp"/>


</LinearLayout>
</layout>
