<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools">
    <data class="ItemTrendingVideoBigBinding">


    </data>
    <LinearLayout
        android:id="@+id/parent"
        android:layout_width="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="horizontal"
        android:layout_height="wrap_content"
        xmlns:android="http://schemas.android.com/apk/res/android">


        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_view_white"
            app:cardElevation="@dimen/_5sdp"
            android:layout_margin="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_5sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_130sdp">

                    <ImageView
                        android:id="@+id/imageVideo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/image6"
                        android:scaleType="centerCrop" />



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#48000000"
                        android:layout_gravity="bottom">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_baseline_play_arrow_24"
                            app:tint="@color/white"
                            android:layout_gravity="center"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:padding="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:elevation="@dimen/_10sdp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/titleVido"
                                android:layout_width="match_parent"
                                android:textColor="@color/white"
                                android:layout_height="wrap_content"
                                style="@style/font_medium"
                                android:textSize="10sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="KL Rahul Is The Most Popular Batsaman To Reach The 500 Run Mark in The Fifth Seacon of IPL"/>


                            <TextView
                                android:id="@+id/dateTimeVideo"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_width="match_parent"
                                android:textColor="@color/txt_color"
                                android:textSize="10sp"
                                android:visibility="gone"
                                android:text="14 hours ago"
                                android:layout_height="wrap_content"
                                />


                        </LinearLayout>

                    </LinearLayout>




                </FrameLayout>





            </LinearLayout>

        </androidx.cardview.widget.CardView>



    </LinearLayout>
</layout>
