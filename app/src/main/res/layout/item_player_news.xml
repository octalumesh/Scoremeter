<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data class="ItemPlayerNewsBinding">


    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:backgroundTint="@color/card_view_white">


        <LinearLayout
            android:id="@+id/parent"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            >

            <androidx.cardview.widget.CardView
                android:layout_weight="0.30"
                android:layout_width="0dp"
                android:layout_height="@dimen/_65sdp"
                app:cardCornerRadius="@dimen/_5sdp">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher_round" />

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="0.70"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    style="@style/font_regular"
                    android:textColor="@color/txt_color"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    tools:text="KL Rahul Is The Most Popular Batsaman To Reach The 500 Run Mark in The Fifth Seacon of IPL"/>


                <TextView
                    android:id="@+id/time"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_width="match_parent"
                    android:textColor="@color/txt_lgt"
                    style="@style/font_regular"
                    android:textSize="12sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    tools:text="6 days ago"/>



            </LinearLayout>



        </LinearLayout>

        <TextView
            android:id="@+id/description"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:textColor="@color/txt_lgt"
            style="@style/font_regular"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_height="wrap_content"
            tools:text="KL Rahul Is The Most Popular Batsaman To Reach The 500 Run Mark in The Fifth Seacon of IPLfgggfggfg"/>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_view"/>

    </LinearLayout>


</layout>
